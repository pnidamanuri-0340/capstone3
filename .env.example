# ---- AI model: set ONE of these keys ------------------------------------
# OpenAI (paid API): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini (free tier, no credit card): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Anthropic Claude (paid API, separate from Claude Pro/Max): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# auto = first key found in this order: OpenAI, Gemini, Claude. Or force: openai / google / anthropic
FINLIT_PROVIDER=auto

# ---- Live market data (optional) -----------------------------------------
# Free key: https://www.alphavantage.co/support/#api-key
# Leave blank or set ALPHA_VANTAGE_MOCK=true to use bundled sample data.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_MOCK=false

# ---- Models ----------------------------------------------------------------
FINLIT_OPENAI_AGENT_MODEL=gpt-4o
FINLIT_OPENAI_ROUTER_MODEL=gpt-4o-mini
FINLIT_GEMINI_AGENT_MODEL=gemini-3.5-flash
FINLIT_GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
FINLIT_AGENT_MODEL=claude-sonnet-5-5
FINLIT_ROUTER_MODEL=claude-haiku-4-5-20251001
# Leave blank for the model default (some models, e.g. Sonnet 5.5, don't allow changing it)
FINLIT_TEMPERATURE=

# ---- Storage (relative paths resolve against the folder you run from) ------
FINLIT_DATA_DIR=./data

# onnx = all-MiniLM-L6-v2 (downloads ~80MB once). hash = offline test embeddings.
FINLIT_EMBEDDINGS=onnx
FINLIT_RAG_TOP_K=4

LOG_LEVEL=INFO
